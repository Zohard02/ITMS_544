{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "OnlyTheLabBucketsThroughThisEndpoint",
   "Effect": "Allow",
   "Principal": "*",
   "Action": [
    "s3:GetObject",
    "s3:PutObject",
    "s3:ListBucket"
   ],
   "Resource": [
    "arn:aws:s3:::${data_bucket}",
    "arn:aws:s3:::${data_bucket}/*",
    "arn:aws:s3:::${artifact_bucket}",
    "arn:aws:s3:::${artifact_bucket}/*"
   ]
  },
  {
   "Sid": "AmazonLinuxPackageRepositories",
   "Effect": "Allow",
   "Principal": "*",
   "Action": "s3:GetObject",
   "Resource": "arn:aws:s3:::al2023-repos-${region}-de612dc2/*"
  }
 ]
}
