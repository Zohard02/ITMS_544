{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "ListNimbusUsers",
   "Effect": "Allow",
   "Action": "iam:ListUsers",
   "Resource": "*"
  },
  {
   "Sid": "ReadNimbusUserState",
   "Effect": "Allow",
   "Action": [
    "iam:GetUser",
    "iam:GetLoginProfile",
    "iam:ListAccessKeys",
    "iam:ListGroupsForUser",
    "iam:ListMFADevices",
    "iam:ListAttachedUserPolicies",
    "iam:ListUserTags"
   ],
   "Resource": "arn:aws:iam::${account_id}:user/nimbus/*"
  },
  {
   "Sid": "ReadRegistry",
   "Effect": "Allow",
   "Action": "s3:GetObject",
   "Resource": [
    "arn:aws:s3:::${bucket}/registry/*",
    "arn:aws:s3:::${bucket}/audit/*"
   ]
  },
  {
   "Sid": "ListRegistry",
   "Effect": "Allow",
   "Action": "s3:ListBucket",
   "Resource": "arn:aws:s3:::${bucket}",
   "Condition": {
    "StringLike": {
     "s3:prefix": [
      "registry/*",
      "audit/*"
     ]
    }
   }
  },
  {
   "Sid": "ReadInternalToken",
   "Effect": "Allow",
   "Action": "ssm:GetParameter",
   "Resource": [
    "arn:aws:ssm:${region}:${account_id}:parameter${param_prefix}/internal-token/current",
    "arn:aws:ssm:${region}:${account_id}:parameter${param_prefix}/internal-token/previous"
   ]
  }
 ]
}
